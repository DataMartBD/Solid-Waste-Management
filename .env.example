# Frontend configuration. Copy to .env.local for local overrides.
#
# Left blank, the app calls /api on its own origin — which the Vite dev server
# proxies to the Django backend (see vite.config.js). Set these only when the
# backend lives somewhere else, e.g. a deployed build talking to a remote API.

# VITE_API_BASE_URL=http://127.0.0.1:8000/api
# VITE_WS_URL=ws://127.0.0.1:8000

# Copy to server/.env and fill in. server/.env is gitignored.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# PostgreSQL 18 — discrete vars, not a URL: a '#' in a password is a URL fragment.
# Quote the password if it contains '#' or ';' — unquoted, everything from the
# '#' onwards is read as an end-of-line comment and authentication then fails.
DB_NAME=swms
DB_USER=postgres
DB_PASSWORD='your-postgres-password'
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth tuning
OTP_TTL_SECONDS=300
# Returns the OTP in the API response so the login screen can show it as a
# demo hint. Only honoured while DJANGO_DEBUG=True. Set False for real SMS.
OTP_EXPOSE_CODE=True
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_SECONDS=900

# Sweep AI assistant — leave blank to disable the endpoint gracefully.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Optional: multi-process realtime needs Redis. Blank = in-memory (single process).
REDIS_URL=
